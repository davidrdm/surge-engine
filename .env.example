# Surge I&W credentials — TEMPLATE ONLY.
#
#   cp .env.example .env && chmod 600 .env
#
# Then fill in .env. Never put a value in THIS file: .env is gitignored,
# .env.example is committed.
#
# Format is shell-sourceable: NAME=value, no spaces around '='. Quote any value
# containing spaces or shell metacharacters. Do not export; the loader handles
# that.

# --- Social media ------------------------------------------------------------
# apidirect.io — no sandbox environment exists. Pay-per-request from $0.003.
APIDIRECT_API_KEY=

# --- Flights -----------------------------------------------------------------
# fr24api.flightradar24.com. Sandbox and production use the SAME base URL and
# paths; only the key differs. A sandbox key returns static responses that
# IGNORE ALL QUERY PARAMETERS, costs no credits, and is unlimited.
#
# Both are listed because they test different things: the sandbox proves the
# parsing and auth wiring, and only a live call can prove the query parameters
# are correct — a wrong `airports` or `categories` value passes sandbox silently.
FR24_API_KEY=
FR24_SANDBOX_KEY=

# --- Lodging -----------------------------------------------------------------
# api.stayingapi.com. Keys are self-describing: stay_test_ is sandbox and free,
# stay_live_ is production. Start with the test key; GET /account costs zero
# credits and reports which environment a key belongs to.
STAYING_API_KEY=

# --- Rental cars -------------------------------------------------------------
# priceline8.p.rapidapi.com via RapidAPI. No sandbox environment exists.
PRICELINE_RAPIDAPI_KEY=

# --- LLM ---------------------------------------------------------------------
# Not needed until Phase 3 (triage). Must match llm.api_key_env in config.yaml.
GEMINI_API_KEY=

# --- Surge I&W's own API token ----------------------------------------------
# NOT issued by anyone — you generate this yourself. It is the bearer token that
# gates this system's REST API, and it is only used from Phase 6 onward.
#
# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Anything that calls the API must send it as: Authorization: Bearer <token>
SURGE_API_TOKEN=
