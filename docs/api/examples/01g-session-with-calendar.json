{
  "name": "01g-session-with-calendar",
  "note": "`calendar_set` names a calendar of scheduled events in the same `inputs.dir` — context, never input: triage shows the events to the model as background and correlations record the ones overlapping their window, but no score or band ever moves. Same NAME-not-path rule and the same all-or-nothing loading as `input_set`.",
  "request": {
    "method": "POST",
    "path": "/v1/sessions",
    "headers": {
      "Authorization": "Bearer <SURGE_API_TOKEN>"
    },
    "body": {
      "label": "with a calendar of scheduled events",
      "cities": [
        {
          "name": "Phoenix",
          "state": "AZ",
          "key_locations": [
            {
              "name": "Riverside Fairground",
              "address": "510 S 3rd Ave, Phoenix, AZ",
              "location_type": "FAIRGROUND"
            }
          ]
        }
      ],
      "tracks": [
        "AIRSHOW"
      ],
      "calendar_set": "example-calendar"
    }
  },
  "response": {
    "status": 201,
    "body": {
      "session_id": 4,
